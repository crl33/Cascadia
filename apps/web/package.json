{
  "name": "@cascadia-papsukkal/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cascadia Papsukkal web spike: React + TypeScript + CesiumJS renderer over semantic contracts.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "stub": "node dev/stub-api.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "e2e": "VITE_API_BASE=http://localhost:8000 VITE_DOMAIN_WARM=off npm run build && playwright test -c ../../tests/e2e/playwright.config.ts",
    "contracts:gen": "node scripts/gen-contracts.mjs",
    "contracts:check": "node scripts/gen-contracts.mjs --check",
    "doctor": "npx react-doctor@latest --verbose"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "cesium": "^1.144.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.2.2",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
