# Cascadia Papsukkal V2 root ignores (v1/ keeps its own .gitignore)
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
node_modules/
dist/
build/
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage/
.coverage
*.egg-info/
.DS_Store
.idea/
.vscode/
# scientific data caches (never commit raw products)
data/raw/
data/cache/
*.grib2
*.nc
# ...but the checked-in test fixtures are the deterministic inputs of the offline suite and MUST
# be versioned: the blanket rule above silently excluded them, so every NBM test passed locally
# (the files were on disk) and errored in CI with FileNotFoundError. ~1.5 MB total.
!tests/fixtures/**/*.grib2
!tests/fixtures/**/*.nc
*.grb2
*.nc
*.tif
*.tiff
*.laz
*.las

# local spike data (sqlite db + raw archive)
data/
.wrangler/
.terrain-work/
