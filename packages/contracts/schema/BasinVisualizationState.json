{
  "$defs": {
    "AgreementLevel": {
      "enum": [
        "high",
        "moderate",
        "low",
        "unknown"
      ],
      "title": "AgreementLevel",
      "type": "string"
    },
    "AgreementState": {
      "additionalProperties": false,
      "properties": {
        "explanation_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explanation Ref"
        },
        "prov": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Prov",
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "why UNKNOWN/LOW, when it is",
          "title": "Reason"
        },
        "state": {
          "$ref": "#/$defs/AgreementLevel"
        }
      },
      "required": [
        "state"
      ],
      "title": "AgreementState",
      "type": "object"
    },
    "BandBoundary": {
      "description": "Whether the reference distribution can separate this value from a band edge.\n\nA **condition**, not a confidence: there is no number here and no coverage claim. The\nday-of-year ladder's breakpoints are sample quantiles estimated from a finite number of\nindependent years, so a value sitting a point or two from a band edge is not distinguishable\nfrom the other side of it by the record that drew the edge.\n\n- ``separated`` \u2014 no band edge lies inside the reported sampling error of the percentile.\n- ``near_band_edge`` \u2014 one does; :attr:`HydrologicState.bands_within_sampling_error` names\n  the bands the record cannot tell apart here.\n- ``unquantified`` \u2014 the sample size behind the ladder is not known, so the question cannot\n  be answered at all. This is the **fail-closed** state: it never means \"separated\".",
      "enum": [
        "separated",
        "near_band_edge",
        "unquantified"
      ],
      "title": "BandBoundary",
      "type": "string"
    },
    "BasinSurfaces": {
      "additionalProperties": false,
      "properties": {
        "agreement": {
          "$ref": "#/$defs/AgreementState"
        },
        "forcing": {
          "$ref": "#/$defs/SurfaceState"
        },
        "hazard": {
          "$ref": "#/$defs/HazardState"
        },
        "susceptibility": {
          "$ref": "#/$defs/SurfaceState"
        }
      },
      "required": [
        "susceptibility",
        "forcing",
        "hazard",
        "agreement"
      ],
      "title": "BasinSurfaces",
      "type": "object"
    },
    "ConfidenceLabel": {
      "description": "Categorical by doctrine; numeric confidence is reserved for calibrated quantities.",
      "enum": [
        "high",
        "moderate",
        "low",
        "unknown"
      ],
      "title": "ConfidenceLabel",
      "type": "string"
    },
    "Driver": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "title": "Direction",
          "type": "string"
        },
        "feature": {
          "title": "Feature",
          "type": "string"
        },
        "prov": {
          "title": "Prov",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "feature",
        "direction",
        "rank",
        "prov"
      ],
      "title": "Driver",
      "type": "object"
    },
    "FloodCategory": {
      "enum": [
        "none",
        "action",
        "minor",
        "moderate",
        "major",
        "unknown"
      ],
      "title": "FloodCategory",
      "type": "string"
    },
    "GeometryRef": {
      "additionalProperties": false,
      "properties": {
        "feature_id": {
          "title": "Feature Id",
          "type": "string"
        },
        "lod": {
          "pattern": "^(orbital|state|basin|river|local|ground)$",
          "title": "Lod",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "GeoJSON or tile URL template; cartographic truth class",
          "title": "Url"
        }
      },
      "required": [
        "lod",
        "feature_id"
      ],
      "title": "GeometryRef",
      "type": "object"
    },
    "HazardState": {
      "additionalProperties": false,
      "properties": {
        "cascade_index": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "only after hindcast evaluation (ADR-0008)",
          "title": "Cascade Index"
        },
        "horizon_h": {
          "minimum": 0,
          "title": "Horizon H",
          "type": "integer"
        },
        "model_probability": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. {\"model\": \"nwm-mr-ens\", \"exceeds\": \"minor\", \"fraction\": 0.43}",
          "title": "Model Probability"
        },
        "official_category": {
          "$ref": "#/$defs/FloodCategory"
        },
        "official_prov": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Official Prov"
        },
        "prov": {
          "description": "key into ContractEnvelope.provenance_refs",
          "title": "Prov",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "truth": {
          "$ref": "#/$defs/TruthClass"
        }
      },
      "required": [
        "prov",
        "truth",
        "horizon_h",
        "official_category"
      ],
      "title": "HazardState",
      "type": "object"
    },
    "HydrologicState": {
      "additionalProperties": false,
      "description": "Where the river is: one observation said three ways that are never combined.\n\n`percentile` is the shipped, still-clamped day-of-year percentile \u2014 unchanged, uncalibrated\nand EXPERIMENTAL. `rank` says how unusual it is against a named record. `multiple` says how\nbig it is against a named reference. **There is no fourth field summarising the three, and\nthere must never be one**: a composite of these would be exactly the flood-risk score the\ndoctrine forbids. A client may not colour, size or order one of them by another.",
      "properties": {
        "bands_within_sampling_error": {
          "default": [],
          "description": "the bands the reference distribution cannot separate here; empty when it can",
          "items": {
            "$ref": "#/$defs/SurfaceLevel"
          },
          "title": "Bands Within Sampling Error",
          "type": "array"
        },
        "boundary": {
          "$ref": "#/$defs/BandBoundary",
          "default": "unquantified"
        },
        "day": {
          "description": "the station-local calendar day the daily mean covers",
          "format": "date",
          "title": "Day",
          "type": "string"
        },
        "multiple": {
          "anyOf": [
            {
              "$ref": "#/$defs/SeasonalMultiple"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "observed": {
          "$ref": "#/$defs/Quantity",
          "description": "the daily-mean flow the three statements are about"
        },
        "percentile": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Percentile"
        },
        "percentile_clamped": {
          "default": false,
          "description": "the value fell outside the stored ladder, so the percentile is a bound, not an estimate",
          "title": "Percentile Clamped",
          "type": "boolean"
        },
        "prov": {
          "title": "Prov",
          "type": "string"
        },
        "rank": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordRank"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReferenceWindow"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "truth": {
          "$ref": "#/$defs/TruthClass"
        }
      },
      "required": [
        "prov",
        "truth",
        "observed",
        "day"
      ],
      "title": "HydrologicState",
      "type": "object"
    },
    "OfficialAlert": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "title": "Event",
          "type": "string"
        },
        "expires": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "issuer": {
          "title": "Issuer",
          "type": "string"
        },
        "onset": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Onset"
        },
        "prov": {
          "title": "Prov",
          "type": "string"
        },
        "severity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        }
      },
      "required": [
        "id",
        "event",
        "issuer",
        "prov"
      ],
      "title": "OfficialAlert",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "description": "A number with its unit; `datum` is required for stage-like quantities.",
      "properties": {
        "datum": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Datum"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "RecordRank": {
      "additionalProperties": false,
      "description": "Where the value sits among the reference window sample, as a count and nothing more.\n\nDeliberately not a plotting position: \"3rd largest of 491 daily means\" says its own sample\nsize, where \"p99.48\" advertises resolution the sample does not have. Censored at 1 \u2014 a value\nabove the record maximum is \"the largest\", and so is one twice as big \u2014 but it censors\nHONESTLY, naming the record it beat. `rank` is None where only a bound is available, and\n`reason` then says why.",
      "properties": {
        "exceeds_record": {
          "default": false,
          "title": "Exceeds Record",
          "type": "boolean"
        },
        "of": {
          "description": "sample size including the value being ranked",
          "minimum": 1,
          "title": "Of",
          "type": "integer"
        },
        "previous_max": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "previous_max_day": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Max Day"
        },
        "prov": {
          "title": "Prov",
          "type": "string"
        },
        "rank": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1 = largest; None when only a bound is known",
          "title": "Rank"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "of",
        "prov"
      ],
      "title": "RecordRank",
      "type": "object"
    },
    "ReferenceWindow": {
      "additionalProperties": false,
      "description": "The empirical day-of-year sample a level statement is ranked against.\n\nPrinted beside every number derived from it, because a rank means nothing without the\nsample it is a rank in. `independent_years` is the sample count deflated by the smoothing\nwindow (a \u00b12-day window pools 5 consecutive days of each year, so `n` days are not `n`\nindependent draws); it is the denominator any statement about sampling error must use.",
      "properties": {
        "doy_key": {
          "description": "day-of-year key, \"MM-DD\"",
          "pattern": "^\\d{2}-\\d{2}$",
          "title": "Doy Key",
          "type": "string"
        },
        "independent_years": {
          "description": "n deflated by the smoothing window; the honest denominator",
          "minimum": 0,
          "title": "Independent Years",
          "type": "integer"
        },
        "method_id": {
          "description": "the climatology method that built the sample, method:<name>@<semver>",
          "title": "Method Id",
          "type": "string"
        },
        "n": {
          "description": "values in the window sample",
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "period_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period End"
        },
        "period_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "first calendar year of the record the reference was built from. A calendar SPAN, not a count of years with data: a gauge can reach back further than it observed",
          "title": "Period Start"
        },
        "window_days": {
          "description": "half-width of the smoothing window in days",
          "minimum": 0,
          "title": "Window Days",
          "type": "integer"
        }
      },
      "required": [
        "doy_key",
        "window_days",
        "n",
        "independent_years",
        "method_id"
      ],
      "title": "ReferenceWindow",
      "type": "object"
    },
    "SeasonalMultiple": {
      "additionalProperties": false,
      "description": "`value \u00f7 the day-of-year reference flow`. Unbounded, and never a flood magnitude.\n\nThe reference is the ladder's TOP stored breakpoint, so `multiple >= 1` is exactly the\ncondition under which the percentile clamps: this begins where the percentile stops\ndiscriminating. It is a multiple of a *seasonal* reference \u2014 a late-summer flash flow on a\ntiny denominator can exceed a winter flood's multiple \u2014 so the absolute flow always renders\nbeside it, and it is never banded on a year-round cutoff.",
      "properties": {
        "multiple": {
          "minimum": 0,
          "title": "Multiple",
          "type": "number"
        },
        "prov": {
          "title": "Prov",
          "type": "string"
        },
        "reference": {
          "$ref": "#/$defs/Quantity",
          "description": "the reference flow itself, in the observation's own unit"
        },
        "reference_percentile": {
          "maximum": 100,
          "minimum": 0,
          "title": "Reference Percentile",
          "type": "integer"
        }
      },
      "required": [
        "multiple",
        "reference_percentile",
        "reference",
        "prov"
      ],
      "title": "SeasonalMultiple",
      "type": "object"
    },
    "StateChange": {
      "additionalProperties": false,
      "description": "How fast the river is moving, as a multiplicative growth of the daily mean over a window.\n\n`growth = Q(t) / Q(t \u2212 window_h)`. Computed on the observation, never on the percentile: the\nladder clamps, so a percentile derivative reads +0 through a crest. Three properties follow\nand all three are load-bearing \u2014 it does not depend on any ladder or its vintage, it has no\nextrapolated region (it is arithmetic on two observations), and it stays exact while the\nlevel is censored.\n\nIt is a **driver, not a score**: nothing here is weighted against the level, and no band edge\nis drawn on it. `rank` answers \"is that fast?\" descriptively, against this gauge's own past\nchanges over the same window, because no evidence yet exists for a cutoff.",
      "properties": {
        "direction": {
          "pattern": "^(rising|falling|steady|unknown)$",
          "title": "Direction",
          "type": "string"
        },
        "from_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "growth": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Q(t) / Q(t \u2212 window_h); dimensionless",
          "title": "Growth"
        },
        "prov": {
          "title": "Prov",
          "type": "string"
        },
        "rank": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1 = largest change in this gauge's record",
          "title": "Rank"
        },
        "rank_of": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rank Of"
        },
        "rank_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "why the rank is absent or a bound",
          "title": "Rank Reason"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "why growth is absent, when it is",
          "title": "Reason"
        },
        "span_h": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the span actually covered, which is what growth is over",
          "title": "Span H"
        },
        "to_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "window_h": {
          "minimum": 1,
          "title": "Window H",
          "type": "integer"
        }
      },
      "required": [
        "window_h",
        "direction",
        "prov"
      ],
      "title": "StateChange",
      "type": "object"
    },
    "SurfaceLevel": {
      "enum": [
        "low",
        "moderate",
        "high",
        "very_high",
        "unknown"
      ],
      "title": "SurfaceLevel",
      "type": "string"
    },
    "SurfaceState": {
      "additionalProperties": false,
      "description": "One of the risk surfaces (docs/HYDROLOGY.md \u00a73\u2013\u00a76).\n\n`state` is the banded answer, `value` is the quantity it was banded from, and `spread`\nnames the uncertainty points that came with that quantity. **None of `score`, `value` or\n`spread` is ever a probability.** Where `experimental` is true the surface is a Cascadia\nPapsukkal derivation whose method has not passed hindcast evaluation, so its number is\nEXPERIMENTAL by definition: it carries a `method_id` through `prov`, it is uncalibrated,\nand no client may render it as a chance of anything (ADR-0008, docs/DATA_DOCTRINE.md \u00a79).\nA threshold-crossing probability may only ever come from counted model members, never\nfrom here. `state = unknown` with a specific `reason` is a legitimate, correct answer;\na fabricated value is not.",
      "properties": {
        "confidence": {
          "$ref": "#/$defs/ConfidenceLabel",
          "default": "unknown"
        },
        "experimental": {
          "default": false,
          "title": "Experimental",
          "type": "boolean"
        },
        "horizon_h": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Horizon H"
        },
        "prov": {
          "description": "key into ContractEnvelope.provenance_refs",
          "title": "Prov",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "why UNKNOWN, when it is",
          "title": "Reason"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "EXPERIMENTAL index in [0,1] from the surface's own band table; never a probability",
          "title": "Score"
        },
        "spread": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "named spread points for `value`, in the SAME unit, e.g. {'p10': 88.0, 'p90': 211.0}. Keys name the method's own statistic and nothing more: a model's pointwise percentile is not a basin-scale percentile and must be labeled as what it is. Never a probability",
          "title": "Spread"
        },
        "state": {
          "$ref": "#/$defs/SurfaceLevel"
        },
        "truth": {
          "$ref": "#/$defs/TruthClass"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the headline quantity `state` was banded from, in its own unit (e.g. 72-h basin-mean QPF in mm, or a day-of-year flow percentile in pct). EXPERIMENTAL whenever `experimental` is true; never a probability"
        }
      },
      "required": [
        "prov",
        "truth",
        "state"
      ],
      "title": "SurfaceState",
      "type": "object"
    },
    "TruthClass": {
      "description": "docs/VISUAL_TRUTH_DOCTRINE.md \u2014 what kind of thing a rendered element is.",
      "enum": [
        "observation",
        "authoritative_model",
        "cascade_derived",
        "cartographic",
        "cinematic"
      ],
      "title": "TruthClass",
      "type": "string"
    }
  },
  "$id": "https://cascadia-papsukkal.dev/schema/BasinVisualizationState.json",
