    "SELECT forecast_run.id, forecast_run.product_id, forecast_run.fp_id, forecast_run.issued_at, forecast_run.retrieved_at, forecast_run.available_at, forecast_run.issuer, forecast_run.primary_variable, forecast_run.unit, forecast_run.stage_unit, forecast_run.flow_unit, forecast_run.datum, forecast_run.raw_artifact_id, forecast_run.supersedes_run_id FROM forecast_run WHERE forecast_run.fp_id = %(fp_id_1)s::VARCHAR AND forecast_run.available_at <= %(available_at_1)s::TIMESTAMP WITHOUT TIME ZONE AND forecast_run.product_id IN (%(product_id_1_1)s::VARCHAR, %(product_id_1_2)s::VARCHAR, %(product_id_1_3)s::VARCHAR) ORDER BY forecast_run.issued_at DESC, forecast_run.id DESC LIMIT %(param_1)s::INTEGER",
