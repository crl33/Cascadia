    "impacts":  [
      {
        "stage":  12000,
        "statement":  "Major river flooding will occur on the lower White River with dangerously fast flowing flood waters in many places in Auburn, Pacific, and Sumner. Many roads and structures will be inundated. Portions of the temporary flood protection barriers may overtop, potentially causing even more widesprea flooding."
      },
      {
        "stage":  10000,
        "statement":  "River flooding may occur upstream of the A Street Bridge in the City of Auburn. River levels will likely be up against the temporary flood protection barriers, with flooding likely at Government Canal and Butte Avenue in the City of Pacific and downstream of the Stewart Street Bridge in the City of Sumner."
      },
      {
        "stage":  7500,
        "statement":  "River flooding is likely to occur near low bank areas around and downstream of the Stewart Streat Bridge in the city of Sumner."
      }
    ]
  },
