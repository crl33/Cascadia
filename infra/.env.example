# Cascadia Papsukkal — environment contract (Phase 0).
# Copy to .env and fill in. Placeholders only — never commit real values.
# All CASCADE_* variables are read by cascade_core.settings.Settings.from_env
# unless noted otherwise.

# ------------------------------------------------------------------ database
# SQLAlchemy URL for the primary database. Local default is SQLite; production
# is PostgreSQL. Neon example (a pooled "-pooler" host is fine HERE):
#   CASCADE_DB_URL=postgresql+psycopg://USER:PASSWORD@HOST/dbname?sslmode=require
CASCADE_DB_URL=sqlite+aiosqlite:///./data/cascade.db

# DIRECT (non-pooled) connection string for the procrastinate worker queue.
# Neon pooled hosts contain "-pooler" in the hostname and cannot carry
# LISTEN/NOTIFY, so they must NOT be used for CASCADE_QUEUE_DB_URL.
# Leave unset to fall back to CASCADE_DB_URL (fine for local dev).
# CASCADE_QUEUE_DB_URL=postgresql+psycopg://USER:PASSWORD@DIRECT_HOST/dbname?sslmode=require

# -------------------------------------------------- object store (raw archive)
# One of: local | s3
CASCADE_OBJECT_STORE=local
# S3-compatible endpoint; R2 pattern: https://<account-id>.r2.cloudflarestorage.com
# CASCADE_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# CASCADE_S3_BUCKET=BUCKET_NAME
# S3 credentials are NEVER stored in Settings: obstore reads these standard
# variables straight from the process environment.
# AWS_ACCESS_KEY_ID=PLACEHOLDER
# AWS_SECRET_ACCESS_KEY=PLACEHOLDER

# ---------------------------------------------------------------- providers
# USGS OGC API key (not used by the legacy IV adapter; plumbing for the OGC
# migration). Secret — never log it.
# CASCADE_USGS_API_KEY=PLACEHOLDER

# -------------------------------------------------------------- paths & app
CASCADE_RAW_DIR=./data/raw
CASCADE_CONTACT=you@example.invalid
CASCADE_CORS_ORIGINS=http://localhost:5173
CASCADE_GEO_DIR=./tests/fixtures/geo
# Port the API server listens on (read by the app server / platform, not Settings).
PORT=8000

# ------------------------------------------- local dev compose (infra/) only
# Password for the postgis service in infra/docker-compose.dev.yml (and
# interpolated into the api/worker CASCADE_DB_URL there). Local throwaway
# value; defaults to "dev" when unset. Not read by Settings.from_env.
# POSTGRES_PASSWORD=dev
